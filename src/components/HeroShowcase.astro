---
import { heroSlides } from "../data/heroThemes";
---

<section class="hero-carousel" data-hero-carousel aria-roledescription="carrusel" aria-label="Líneas principales">
	<div class="hero-carousel-track">
		{
			heroSlides.map((slide, index) => (
				<article
					class:list={["hero-slide", { "is-active": index === 0 }]}
					data-slide
					style={`--slide-color: ${slide.color}`}
					aria-hidden={index === 0 ? "false" : "true"}
				>
					<div class:list={["hero-scene", `hero-scene--${slide.slug}`]} aria-hidden="true">
						<div class="hero-scene-glow" />
						<div class="hero-scene-grid" />
					</div>
					<div class="hero-slide-scrim" aria-hidden="true" />
					<figure class="hero-figure">
						<img
							src={slide.image}
							alt={slide.imageAlt}
							width="720"
							height="720"
							loading={index === 0 ? "eager" : "lazy"}
							decoding="async"
							fetchpriority={index === 0 ? "high" : "auto"}
						/>
						<figcaption class="hero-scene-audience">{slide.audience}</figcaption>
					</figure>
					<div class="hero-slide-copy">
						<p class="eyebrow">{slide.eyebrow}</p>
						<h1>
							{slide.title}
							<br />
							<em>{slide.titleAccent}</em>
						</h1>
						<p class="hero-intro">{slide.detail}</p>
						<a class="hero-cta" href={slide.href}>
							{slide.cta}
							<span aria-hidden="true">↓</span>
						</a>
					</div>
				</article>
			))
		}
	</div>

	<div class="hero-carousel-dots" role="tablist" aria-label="Slides del hero">
		{
			heroSlides.map((slide, index) => (
				<button
					type="button"
					class:list={[{ "is-active": index === 0 }]}
					data-dot
					aria-label={slide.eyebrow}
					aria-selected={index === 0 ? "true" : "false"}
				/>
			))
		}
	</div>
</section>

<script>
	const root = document.querySelector("[data-hero-carousel]");
	if (root instanceof HTMLElement) {
		const slides = Array.from(root.querySelectorAll("[data-slide]"));
		const dots = Array.from(root.querySelectorAll("[data-dot]"));
		const intervalMs = 6200;
		let index = 0;
		let timer = 0;

		const show = (nextIndex) => {
			slides[index]?.classList.remove("is-active");
			dots[index]?.classList.remove("is-active");
			slides[index]?.setAttribute("aria-hidden", "true");
			slides[index]?.setAttribute("inert", "");
			dots[index]?.setAttribute("aria-selected", "false");
			index = (nextIndex + slides.length) % slides.length;
			slides[index]?.classList.add("is-active");
			dots[index]?.classList.add("is-active");
			slides[index]?.setAttribute("aria-hidden", "false");
			slides[index]?.removeAttribute("inert");
			dots[index]?.setAttribute("aria-selected", "true");
		};

		slides.forEach((slide, i) => {
			if (i !== 0) slide.setAttribute("inert", "");
		});

		const play = () => {
			window.clearInterval(timer);
			if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
			timer = window.setInterval(() => show(index + 1), intervalMs);
		};

		dots.forEach((dot, i) => {
			dot.addEventListener("click", () => {
				show(i);
				play();
			});
		});

		root.addEventListener("pointerenter", () => window.clearInterval(timer));
		root.addEventListener("pointerleave", play);
		play();
	}
</script>
