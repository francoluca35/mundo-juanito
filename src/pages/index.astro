---
import Layout from "../components/Layout.astro";
import Icon from "../components/Icon.astro";
import HeroShowcase from "../components/HeroShowcase.astro";
import { sections } from "../data/sections.js";
import { whatsappLink } from "../lib/whatsapp";

const printSteps = [
  { title: "Nos contás la idea", detail: "Mandanos una foto, un boceto o las medidas de lo que necesitás." },
  { title: "La diseñamos", detail: "Modelamos la pieza en 3D y te mostramos cómo va a quedar." },
  { title: "La imprimimos", detail: "Elegís el color, la imprimimos y coordinamos la entrega." },
];
---

<Layout title="Productos impresos en 3D">
  <HeroShowcase />

  <section id="explorar" class="worlds">
    <header class="section-heading" data-reveal>
      <p class="eyebrow">Nuestros productos</p>
      <h2>Cinco líneas.<br /><em>Todo impreso en 3D.</em></h2>
    </header>
    <div class="world-path">
      {
        sections.map((section, index) => (
          <article
            class:list={["world-row", { reverse: index % 2 }]}
            style={`--section-color:${section.color}; --ink:${section.ink}`}
            data-reveal
          >
            <span class="world-number">{section.number}</span>
            <a class="world-icon" href={`/${section.slug}/`} aria-label={`Explorar ${section.label}`}>
              <Icon name={section.slug} />
            </a>
            <div class="world-copy">
              <p>{section.eyebrow}</p>
              <h3><a href={`/${section.slug}/`}>{section.label}</a></h3>
              <span>{section.description}</span>
            </div>
            <a class="world-arrow" href={`/${section.slug}/`} aria-label={`Ir a ${section.label}`}>↗</a>
          </article>
        ))
      }
    </div>
  </section>

  <section class="custom-print">
    <header data-reveal>
      <p class="eyebrow">Impresión a medida</p>
      <h2>¿Tenés una idea?<br /><em>La imprimimos.</em></h2>
      <p>Una pieza que se rompió, un regalo único o el material que tu clase necesita: lo diseñamos y lo imprimimos para vos.</p>
    </header>
    <ol class="print-steps">
      {
        printSteps.map((step, index) => (
          <li data-reveal>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <h3>{step.title}</h3>
            <p>{step.detail}</p>
          </li>
        ))
      }
    </ol>
    <a class="whatsapp-button" href={whatsappLink("¡Hola! Quiero consultar por una impresión 3D a medida.")} target="_blank" rel="noopener noreferrer" data-reveal>
      Consultar por WhatsApp <span aria-hidden="true">↗</span>
    </a>
  </section>

  <section class="closing-statement" data-reveal>
    <p>Si se puede imaginar,<br />se puede imprimir.</p>
    <span>Capa por capa.</span>
  </section>
</Layout>
