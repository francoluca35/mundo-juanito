---
const brandWords = ["El", "Mundo", "De", "Juanito"];
---

<a class="brand" href="/" aria-label="El Mundo de Juanito, inicio">
  <span class="brand-name" aria-hidden="true">
    {
      brandWords.map((word) => (
        <span class="brand-word">
          <span class="brand-initial">{word[0]}</span>
          <span class="brand-rest">
            {[...word.slice(1)].map((letter) => (
              <span>{letter}</span>
            ))}
          </span>
        </span>
      ))
    }
  </span>
</a>

<style>
  .brand {
    display: flex;
    align-items: center;
    justify-self: start;
    width: 10.6em;
    min-height: 56px;
    font: 800 clamp(1.3rem, 2.3vw, 1.75rem) / 1 "Baloo 2", sans-serif;
  }

  .brand-name {
    display: flex;
    align-items: baseline;
    white-space: nowrap;
    letter-spacing: 0.01em;
    filter: drop-shadow(1.5px 0 0 var(--deep-blue)) drop-shadow(-1.5px 0 0 var(--deep-blue))
      drop-shadow(0 1.5px 0 var(--deep-blue)) drop-shadow(0 -1.5px 0 var(--deep-blue))
      drop-shadow(0 2px 0 var(--deep-blue));
  }

  .brand-word {
    display: inline-flex;
    align-items: baseline;
  }

  .brand-initial {
    display: inline-block;
    font-size: 1.35em;
    animation: brand-pop 7s ease-in-out infinite;
  }

  .brand-rest {
    display: inline-flex;
    align-items: baseline;
    animation: brand-gap 7s cubic-bezier(0.65, 0, 0.35, 1) infinite;
  }

  .brand-rest span {
    display: inline-block;
    max-width: 0;
    opacity: 0;
    transform: scale(0);
    transform-origin: 50% 80%;
    animation: brand-letter 7s cubic-bezier(0.34, 1.4, 0.64, 1) infinite;
    animation-delay: calc(var(--brand-delay, 0s) + var(--letter-index, 0) * 70ms);
  }

  .brand-rest span:nth-child(2) {
    --letter-index: 1;
  }

  .brand-rest span:nth-child(3) {
    --letter-index: 2;
  }

  .brand-rest span:nth-child(4) {
    --letter-index: 3;
  }

  .brand-rest span:nth-child(5) {
    --letter-index: 4;
  }

  .brand-rest span:nth-child(6) {
    --letter-index: 5;
  }

  .brand-word:not(:last-child) .brand-rest {
    --brand-gap: 0.28em;
  }

  .brand-word:nth-child(2) {
    --brand-delay: 0.1s;
  }

  .brand-word:nth-child(3) {
    --brand-delay: 0.45s;
  }

  .brand-word:nth-child(4) {
    --brand-delay: 0.55s;
  }

  .brand-initial,
  .brand-rest {
    animation-delay: var(--brand-delay, 0s);
  }

  .brand-word:nth-child(1) .brand-initial {
    color: #1e88e5;
  }

  .brand-word:nth-child(2) .brand-initial {
    color: #43b649;
  }

  .brand-word:nth-child(3) .brand-initial {
    color: #ffc31f;
  }

  .brand-word:nth-child(4) .brand-initial {
    color: #f34b45;
  }

  .brand-rest span:nth-child(6n + 1) {
    color: #9c4fd6;
  }

  .brand-rest span:nth-child(6n + 2) {
    color: #ff8a1f;
  }

  .brand-rest span:nth-child(6n + 3) {
    color: #1e88e5;
  }

  .brand-rest span:nth-child(6n + 4) {
    color: #43b649;
  }

  .brand-rest span:nth-child(6n + 5) {
    color: #ffc31f;
  }

  .brand-rest span:nth-child(6n) {
    color: #f34b45;
  }

  .brand:hover .brand-initial {
    transform: translateY(-2px) rotate(-6deg);
  }

  @keyframes brand-letter {
    0%,
    14% {
      max-width: 0;
      opacity: 0;
      transform: scale(0);
    }
    22%,
    76% {
      max-width: 1em;
      opacity: 1;
      transform: none;
    }
    84%,
    100% {
      max-width: 0;
      opacity: 0;
      transform: scale(0);
    }
  }

  @keyframes brand-gap {
    0%,
    14% {
      margin-right: 0;
    }
    22%,
    76% {
      margin-right: var(--brand-gap, 0);
    }
    84%,
    100% {
      margin-right: 0;
    }
  }

  @keyframes brand-pop {
    0%,
    100% {
      transform: none;
    }
    6% {
      transform: translateY(-4px) rotate(-6deg) scale(1.08);
    }
    12% {
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .brand-initial,
    .brand-rest,
    .brand-rest span {
      animation: none;
    }

    .brand-rest {
      margin-right: var(--brand-gap, 0);
    }

    .brand-rest span {
      max-width: none;
      opacity: 1;
      transform: none;
    }
  }
</style>
